  ],
  "forbidden": [
    "change_v2_thresholds_after_cross_dataset_comparison",
    "reuse_v1_cross_dataset_distances_for_v2_thresholds",
    "use_overlap_distances_for_model_selection",
    "inspect_protected_predictions_or_metrics",
    "unlock_D3_training_when_calibration_is_not_separated",
    "unlock_D3_training_when_any_v2_suspect_remains",
