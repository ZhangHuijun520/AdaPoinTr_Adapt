    "protected": [
      "skullbreak-pointcloud-out8192",
      "skullfix-pointcloud-out8192"
    ],
    "reported_provenance": {
      "mug500plus": "Medical University of Graz clinical-routine head CT scans",
      "skullbreak_skullfix": "CQ500 public head CT collection",
      "references": [
        "https://doi.org/10.1016/j.dib.2021.107524",
        "https://doi.org/10.1016/j.dib.2021.106902"
      ]
    }
  },
  "access_boundary": {
    "allowed_arrays": ["gt"],
    "allowed_metadata": [
      "case_id",
