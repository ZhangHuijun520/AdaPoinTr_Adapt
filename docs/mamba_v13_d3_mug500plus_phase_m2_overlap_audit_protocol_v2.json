    "coarse_alignment_points": 1024,
    "high_resolution_points": 4096,
    "descriptor_points": 1024,
    "deterministic_subsample": "lexicographic_xyz_then_even_index",
    "descriptor": {
      "covariance_eigenvalues": 3,
      "radial_quantiles": 49,
      "pairwise_distance_quantiles": 49
    }
  },
  "candidate_screen": {
    "descriptor_distance": "euclidean_after_featurewise_median_mad_scaling",
    "nearest_protected_per_mug_skull": 5,
    "screen_runs_separately_per_protected_dataset": true,
    "v1_candidate_rows_reused": false
  },
  "rigid_alignment": {
    "coarse_initializations": "all_6_axis_permutations_x_8_sign_combinations",
    "coarse_initializations_retained": 2,
    "reflections_allowed_for_audit_sensitivity": true,
    "high_resolution_refinement": "deterministic_bidirectional_nearest_neighbor_ICP",
    "icp_iterations": 6,
    "reported_distances": [
      "symmetric_chamfer_l1_normalized",
      "symmetric_hd95_normalized"
    ]
  },
  "calibration": {
    "uses_cross_dataset_results": false,
    "positive_pairs": [
      "one_deterministic_mug_same_source_pair_per_skull",
      "one_deterministic_skullbreak_same_source_pair_per_skull"
    ],
    "negative_pairs": [
      "one_deterministic_distinct_source_pair_per_mug_skull",
      "one_deterministic_distinct_source_pair_per_skullbreak_skull",
      "one_deterministic_distinct_source_pair_per_skullfix_skull"
    ],
    "positive_limit": "q99_for_each_metric",
    "negative_limit": "q01_for_each_metric",
    "calibration_separation_rule": "positive_q99_lt_negative_q01_for_both_metrics",
    "decision_threshold": "midpoint_of_positive_q99_and_negative_q01_for_each_metric",
    "suspect_rule": "cd_le_threshold_and_hd95_le_threshold"
  },
  "automatic_gate": {
    "pass_rule": "calibration_separated_and_zero_exact_intersections_and_zero_high_resolution_suspects",
