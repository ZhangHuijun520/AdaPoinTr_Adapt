    "L_point": {
      "definition": "case_balanced_binary_cross_entropy_on_shared_point_calibration_logits"
    },
    "L_support": {
      "selected_positive_mass": "sum(straight_through_assignment * positive_mask)",
      "definition": "softplus(beta * (target_mass - selected_positive_mass)) / beta",
      "target_mass": 0.5,
      "beta": 8.0,
      "purpose": "penalize a hard-forward selected set with zero positive anchors"
    },
    "L_shape": {
      "row_entropy": "mean_over_slots(-sum(p*log(p+epsilon))/log(candidate_count))",
      "column_collision": "sum_over_candidates(relu(sum_over_slots(p)-1)^2)/slot_count",
      "definition": "row_entropy + column_collision",
      "epsilon": 1e-08,
      "purpose": "encourage sharp non-collapsed slot distributions without defining uniqueness"
    },
    "total_after_calibration": "L_point + lambda_support*L_support + lambda_shape*L_shape"
  },
